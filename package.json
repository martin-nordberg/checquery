{
	"name": "checquery",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"trustedDependencies": [
		"@tailwindcss/oxide"
	],
	"scripts": {
		"start": "bun run --cwd packages/client build && electrobun dev",
		"dev": "electrobun dev --watch",
		"build": "bun run --cwd packages/client build",
		"test": "bun run test:shared && bun run test:server && bun run test:client",
		"test:shared": "cd packages/shared && bun test",
		"test:server": "cd packages/server && bun test",
		"test:client": "cd packages/client && bun --conditions=browser test",
		"typecheck": "tsc --noEmit -p packages/shared && tsc --noEmit -p packages/server && tsc --noEmit -p packages/client",
		"hash-password": "bun packages/server/scripts/hashPassword.ts"
	},
	"devDependencies": {
		"@types/bun": "1.3.14",
		"typescript": "^5.7.2",
		"concurrently": "^9.1.0",
		"electrobun": "1.18.1"
	},
	"overrides": {
		"@types/bun": "1.3.14",
		"bun-types": "1.3.14"
	}
}
