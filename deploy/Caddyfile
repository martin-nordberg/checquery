# HTTPS front end for Checquery (docker-compose.yml's caddy service). Certificates come from Caddy's own local
# certificate authority; each client computer installs its root certificate once -- see deploy/README.md.
{
	# The container listens on 8443 (published on the same host port by default). Caddy's automatic
	# HTTP->HTTPS redirect would need port 80, which isn't published, so turn it off.
	https_port 8443
	auto_https disable_redirects
	# Don't install the local root into the container's own trust store; clients install it instead.
	skip_install_trust
	# A client connecting by IP address sends no server name, and inside the container Caddy only sees its own
	# Docker address, so it couldn't pick that IP's certificate. Serve this host's certificate to such clients.
	default_sni {$CHECQUERY_TLS_DEFAULT_SNI:localhost}
}

# CHECQUERY_TLS_HOSTS: the names/addresses clients use, comma-separated (Caddy issues a certificate for each).
{$CHECQUERY_TLS_HOSTS:localhost} {
	tls internal
	reverse_proxy checquery:3000
}
