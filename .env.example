# Copy to .env (gitignored) for `bun run dev` / `bun run start`; Bun loads it automatically.
# Docker Compose reads the same file for variable substitution -- see docker-compose.yml.

# Up to two users. Generate each hash with:  bun run hash-password
# It prints the argon2id hash base64-encoded (no "$" characters), so paste it in as-is, unquoted.
CHECQUERY_USER1_NAME=alice
CHECQUERY_USER1_PASSWORD_HASH=REPLACE_WITH_OUTPUT_OF_hash-password
# CHECQUERY_USER2_NAME=bob
# CHECQUERY_USER2_PASSWORD_HASH=

# Where .checquery files (and their backups/) live. Must exist.
# CHECQUERY_DATA_DIR=./data

# CHECQUERY_PORT=3000
# CHECQUERY_HOST=127.0.0.1

# Docker Compose only. Checquery is served over HTTPS by the caddy service, on https://<host>:8443, with
# certificates from Caddy's local CA -- install its root certificate on each client (see deploy/README.md).
# CHECQUERY_TLS_HOSTS: the names/addresses clients will use, comma-separated.
# CHECQUERY_TLS_DEFAULT_SNI: the host whose certificate goes to clients that connect by IP address (they send
# no name) -- set it to that IP if you list one.
# CHECQUERY_BIND_ADDRESS: 0.0.0.0 (or one host address) to allow other computers on the LAN.
# CHECQUERY_TLS_HOSTS=mnserver.internal, 10.168.168.160
# CHECQUERY_TLS_DEFAULT_SNI=10.168.168.160
# CHECQUERY_HTTPS_PORT=8443
# CHECQUERY_BIND_ADDRESS=127.0.0.1
# CHECQUERY_IDLE_CLOSE_MINUTES=60        # 0 disables auto-close of an idle open file
# CHECQUERY_LOGIN_IDLE_MINUTES=480
# CHECQUERY_TRUST_PROXY=false            # true behind a reverse proxy that sets X-Forwarded-* (Compose sets it)
# CHECQUERY_MAX_UPLOAD_MB=200

# Test mode: unencrypted .checquery-test files, no file passwords. Refused when NODE_ENV=production unless
# CHECQUERY_ALLOW_TEST_MODE=true.
# CHECQUERY_ENCRYPTION_DISABLED=true
